# Optional. The live research agent runs the Claude Code CLI (`claude`) with your existing login.
AGENT_MODEL=sonnet          # model alias passed to `claude --model` (library guides were made with opus)
CLAUDE_BIN=claude           # path to the Claude Code CLI if it is not on PATH
AGENT_TIMEOUT_MS=600000     # kill a research run after this long
MAX_CONCURRENT_JOBS=3       # simultaneous live research jobs
